{
  "recipes": [
    {
      "kind": "mail",
      "displayName": "Mail",
      "version": "1.34.0",
      "series": "1",
      "seriesInID": false,
      "licence": "MIT",
      "minimumMacOS": "13.0",
      "assets": [
        {
          "artifact": {
            "url": "https://github.com/axllent/mailpit/releases/download/v1.34.0/mailpit-darwin-amd64.tar.gz",
            "sha256": "a497582d4e9f9a5d0eea84f8622530533dce0797cf8a4952bd7a59487e5d9c7c",
            "size": 11224715
          },
          "archive": "tar.gz",
          "stripComponents": 0
        }
      ],
      "initialise": [],
      "start": {
        "executable": "{bin}/mailpit",
        "arguments": [
          "--listen", "127.0.0.1:{port.http}",
          "--smtp", "127.0.0.1:{port.smtp}",
          "--database", "{data}/mailpit.db",
          "--allowed-hosts", "127.0.0.1:{port.http},localhost:{port.http}",
          "--smtp-auth-accept-any",
          "--smtp-auth-allow-insecure",
          "--disable-version-check"
        ],
        "environment": {}
      },
      "ready": { "http": { "url": "http://127.0.0.1:{port.http}/readyz", "expectStatus": 200 } },
      "stopSignal": "TERM",
      "stopGraceSeconds": 10,
      "ports": [
        { "name": "smtp", "preferred": 1025 },
        { "name": "http", "preferred": 8025 }
      ],
      "env": [
        "MAIL_MAILER=smtp",
        "MAIL_HOST=127.0.0.1",
        "MAIL_PORT={port.smtp}",
        "MAIL_USERNAME=null",
        "MAIL_PASSWORD=null",
        "MAIL_ENCRYPTION=null"
      ],
      "openURL": "http://127.0.0.1:{port.http}",
      "needsPHP": false
    },
    {
      "kind": "postgres",
      "displayName": "PostgreSQL",
      "version": "18.7.0",
      "series": "18",
      "licence": "PostgreSQL",
      "minimumMacOS": "15.0",
      "assets": [
        {
          "artifact": {
            "url": "https://github.com/theseus-rs/postgresql-binaries/releases/download/18.7.0/postgresql-18.7.0-x86_64-apple-darwin.tar.gz",
            "sha256": "9cd649259d6bf4af60a235e772c83853df215b63f4c1967c2eed7f9376aefb89",
            "size": 92187545
          },
          "archive": "tar.gz",
          "stripComponents": 1
        }
      ],
      "initialise": [
        {
          "executable": "{bin}/bin/initdb",
          "arguments": [
            "--pgdata={data}", "--username=root", "--auth=trust", "--encoding=UTF8", "--locale=en_US.UTF-8",
            "--no-instructions"
          ]
        }
      ],
      "start": {
        "executable": "{bin}/bin/postgres",
        "arguments": [
          "-D", "{data}",
          "-p", "{port.main}",
          "-c", "listen_addresses=127.0.0.1",
          "-c", "unix_socket_directories={socketDir}",
          "-c", "hba_file={config}/pg_hba.conf",
          "-c", "logging_collector=off",
          "-c", "log_destination=stderr"
        ]
      },
      "ready": {
        "command": {
          "executable": "{bin}/bin/pg_isready",
          "arguments": ["--host=127.0.0.1", "--port={port.main}", "--quiet"]
        }
      },
      "stopSignal": "INT",
      "stopGraceSeconds": 60,
      "ports": [
        { "name": "main", "preferred": 5432 }
      ],
      "socket": "{run}/.s.PGSQL.{port.main}",
      "lockFiles": ["{data}/postmaster.pid", "{run}/.s.PGSQL.{port.main}.lock"],
      "env": [
        "DB_CONNECTION=pgsql",
        "DB_HOST=127.0.0.1",
        "DB_PORT={port.main}",
        "DB_DATABASE=laravel",
        "DB_USERNAME=root",
        "DB_PASSWORD="
      ],
      "needsPHP": false,
      "configFiles": [
        {
          "path": "{config}/pg_hba.conf",
          "contents": "# Written by Paddock on every start: changes here are replaced.\n# Only this Mac: the instance's own Unix socket and loopback, without a password.\nlocal   all   all                  trust\nhost    all   all   127.0.0.1/32   trust\nhost    all   all   ::1/128        trust\n"
        }
      ],
      "readyTimeoutSeconds": 60,
      "initialiseTimeoutSeconds": 300,
      "actions": {
        "createDatabase": {
          "command": {
            "executable": "{bin}/bin/createdb",
            "arguments": [
              "--host=127.0.0.1", "--port={port.main}", "--username=root", "--no-password", "--", "{database}"
            ]
          },
          "parameters": [
            { "name": "database", "pattern": "^[A-Za-z0-9_]{1,63}$" }
          ],
          "alreadyDone": "database \"{database}\" already exists"
        }
      }
    },
